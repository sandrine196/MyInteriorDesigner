# ── API ────────────────────────────────────────────────────────────────────────
# URL of your deployed Railway backend (no trailing slash)
NEXT_PUBLIC_API_URL=https://your-app.railway.app

# ── Region ─────────────────────────────────────────────────────────────────────
# Controls region-specific UI (cookie consent banner for EU, etc.)
NEXT_PUBLIC_REGION=UK

# ── Feature flags ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_ANALYTICS=true
# Set to "true" to show the EU cookie consent banner
NEXT_PUBLIC_COOKIE_CONSENT=false

# ── Stripe (payments — add when ready) ────────────────────────────────────────
# Publishable key only — never put the secret key here
NEXT_PUBLIC_STRIPE_KEY=pk_live_...

# ── Bot protection (Cloudflare Turnstile) ──────────────────────────────────────
# Site key only — pair with TURNSTILE_SECRET_KEY on the backend.
# Registration proceeds without a check if unset.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
