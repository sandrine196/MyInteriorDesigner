# ── Database ───────────────────────────────────────────────────────────────────
# IMPORTANT: SQLite is for local dev only. Railway has no persistent filesystem
# — every deploy wipes the DB. Use Railway's PostgreSQL add-on for production
# and change the Prisma provider to "postgresql" in prisma/schema.prisma.
#
# Local dev:
#   DATABASE_URL=file:./dev.db
# Railway PostgreSQL (copy from Railway dashboard → Variables):
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Deployed frontend URL — used for the CORS allow-list
FRONTEND_URL=https://myinteriordesigner.co.uk
DEPLOYMENT_REGION=UK

# ── Storage (Cloudflare R2) ────────────────────────────────────────────────────
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=myinteriordesigner-storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=WEUR
# Public URL shown in your R2 bucket dashboard (enable public access first)
STORAGE_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── AI — Gemini (image generation) ────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-ai-api-key
GEMINI_MODEL=gemini-2.5-flash-image

# ── AI — OpenAI (GPT-4o Vision floor plan analysis) ───────────────────────────
# Required for structured floor plan analysis before Gemini generation.
# If omitted, renders still work but floor plan spatial guidance is reduced.
OPENAI_API_KEY=sk-proj-...

# ── Email (Resend) ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=hello@myinteriordesigner.co.uk
# Receives render-failure and suspicious-activity alerts
ALERT_EMAIL=sandrine.andre@gmail.com

# ── Rate limits ────────────────────────────────────────────────────────────────
FREE_RENDERS_PER_MONTH=5
PRO_RENDERS_PER_DAY=100
MAX_RENDERS_PER_HOUR=20
MAX_PROJECTS_FREE=10
MAX_PROJECTS_PRO=100
RENDER_COOLDOWN_SECONDS=30
MAX_CONCURRENT_RENDERS=3

# ── Feature flags ──────────────────────────────────────────────────────────────
USE_MOCK_RENDER=false
ENABLE_ANALYTICS=true
STRICT_GDPR=false
