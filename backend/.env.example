# Database
DATABASE_URL=file:./dev.db

# Security
JWT_SECRET=your-secret-key-here

# AI Generation
# Set AI_PROVIDER=openai to use DALL-E 3, AI_PROVIDER=gemini (default) for Gemini
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
GEMINI_MODEL=gemini-3.1-flash-image-preview
USE_MOCK_RENDER=false

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=myinteriordesigner-storage

# Email (Resend)
# Set EMAIL_PROVIDER=resend and add your API key to enable transactional emails.
# Without these, password reset links are logged to the console instead.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=hello@myinteriordesigner.co.uk

# Regional settings
DEPLOYMENT_REGION=US
STORAGE_REGION=WEURDATABASE_URL="file:./dev.db"
JWT_SECRET="dev-only-change-this-to-a-long-random-string"
GEMINI_API_KEY=""
# Optional: override model (see https://ai.google.dev/gemini-api/docs/image-generation)
GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
