# ── Database ───────────────────────────────────────────────────────────────────
# IMPORTANT: SQLite is for local dev only. Railway has no persistent filesystem
# — every deploy wipes the DB. Use Railway's PostgreSQL add-on for production
# and change the Prisma provider to "postgresql" in prisma/schema.prisma.
#
# Local dev:
#   DATABASE_URL=file:./dev.db
# Railway PostgreSQL (copy from Railway dashboard → Variables):
DATABASE_URL=postgresql://user:password@host:5432/dbname
# Optional read-replica DSN — reads use this instead of DATABASE_URL if set
DATABASE_READ_URL=

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
# Deployed frontend URL — used for the CORS allow-list
FRONTEND_URL=https://myinteriordesigner.co.uk
DEPLOYMENT_REGION=UK

# ── Storage (Cloudflare R2) ────────────────────────────────────────────────────
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=myinteriordesigner-storage
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
STORAGE_REGION=WEUR
# Public URL shown in your R2 bucket dashboard (enable public access first)
STORAGE_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Storage — alternative S3-compatible backend ────────────────────────────────
# Set STORAGE_PROVIDER=s3 (or "scaleway") to use these instead of R2 —
# e.g. for EU-region data residency. See DEPLOYMENT.md for the full picture.
S3_ENDPOINT=
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI — Gemini (image generation) ────────────────────────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=your-google-ai-api-key
GEMINI_MODEL=gemini-2.5-flash-image

# ── AI — OpenAI (GPT-4o Vision floor plan analysis) ───────────────────────────
# Required for structured floor plan analysis before Gemini generation.
# If omitted, renders still work but floor plan spatial guidance is reduced.
OPENAI_API_KEY=sk-proj-...

# Optional override — routes to Google's EU endpoint when set to "EU" (defaults to global)
AI_REGION=global

# REVE_API_KEY removed 2026-08 — Reve API sunset 2026-08-14. Furniture removal
# and virtual staging (public /redesign tool + agent virtual-staging tool) now
# run entirely on Gemini (GEMINI_API_KEY above).

# ── Email (Resend) ─────────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
EMAIL_FROM=hello@myinteriordesigner.co.uk
# Receives render-failure and suspicious-activity alerts
ALERT_EMAIL=you@example.com
# Optional alternative to Resend — SMTP connection string
SMTP_URL=

# ── Bot protection (Cloudflare Turnstile) ──────────────────────────────────────
# Optional — registration proceeds without a check if unset. Get a site/secret
# key pair from the Cloudflare dashboard → Turnstile. The site key is a
# separate NEXT_PUBLIC_ var set on the frontend (see web/.env.example).
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated extra origins allowed to call the API, beyond FRONTEND_URL
# (useful for Vercel preview URLs during development)
EXTRA_ORIGINS=

# ── Rate limits ────────────────────────────────────────────────────────────────
FREE_RENDERS_PER_MONTH=5
PRO_RENDERS_PER_DAY=100
MAX_RENDERS_PER_HOUR=20
MAX_PROJECTS_FREE=10
MAX_PROJECTS_PRO=100
RENDER_COOLDOWN_SECONDS=30
MAX_CONCURRENT_RENDERS=3

# ── CJ Affiliate (Raft Furniture) ─────────────────────────────────────────────
# CJ_CID          = your Publisher Company ID (shown in CJ account settings)
# CJ_API_KEY      = your CJ API key (Publisher → API Keys)
# CJ_RAFT_ADVERTISER_ID = Raft Furniture's advertiser ID in CJ (e.g. 5394447)
# CJ_WEBSITE_ID   = YOUR website/property ID from CJ (Account → My Websites → ID column)
#                   This is DIFFERENT from CJ_CID. Required for working deep links.
#                   Without it, links go direct to raftfurniture.co.uk (no tracking).
#                   To find: CJ publisher interface → Links → Get Link → see the URL format
#                   It's the first number in: click-{WEBSITE_ID}-{ADVERTISER_ID}
CJ_CID=your-cj-publisher-company-id
CJ_API_KEY=your-cj-api-key
CJ_RAFT_ADVERTISER_ID=17172332
# CJ_WEBSITE_ID=your-cj-website-property-id   ← uncomment once you have this

# ── Cost tracking (admin financial dashboard) ──────────────────────────────────
# Railway billing API — find in Railway dashboard → Account → Tokens
RAILWAY_API_KEY=your-railway-api-token
# Your Railway project ID — visible in the project URL: railway.app/project/{id}
RAILWAY_PROJECT_ID=your-railway-project-id

# ── Feature flags ──────────────────────────────────────────────────────────────
USE_MOCK_RENDER=false
ENABLE_ANALYTICS=true
STRICT_GDPR=false

# ── Admin ──────────────────────────────────────────────────────────────────────
# Receives daily backup confirmations and admin test-email checks
ADMIN_EMAIL=you@example.com
